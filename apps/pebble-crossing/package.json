    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^3.2.4"
  }
}
