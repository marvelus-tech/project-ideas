{
  "name": "pebble-crossing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/optimize-world-assets.mjs && node scripts/landing-assets.mjs && tsc -b && vite build && node scripts/copy-spa-stubs.mjs",
    "landing:assets": "node scripts/landing-assets.mjs",
    "optimize:world": "node scripts/optimize-world-assets.mjs",
    "render:pronunciation": "node scripts/render-pronunciation-masters.mjs",
