# CNSTRCT runs with every value below empty.
# Copy to .env.local only when you want a live provider.

# LLM. XAI_API_KEY wins when both are set. Model calls fall back to the scripted demo model on failure.
XAI_API_KEY=
XAI_MODEL=grok-4.7
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# Orgo cloud computer. Both keys are required. Without them the agent uses a local folder sandbox.
# Docker is used only when the daemon already answers and Orgo is unset.
ORGO_API_KEY=
ORGO_WORKSPACE_ID=
ORGO_RAM_GB=4
ORGO_CPU=2

# Reserved. Composio is not called in this MVP. Outreach stays on an approval card either way.
COMPOSIO_API_KEY=

# Optional magic-link auth. Without these, the app keeps a demo session cookie.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin used for canonical URLs and magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Sqlite and sandboxes live here. Defaults to ./data
CNSTRCT_DATA_DIR=
