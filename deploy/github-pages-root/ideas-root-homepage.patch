+                    if (!matchesSearch) return false;
+                }
+
+                if (currentFilters.status !== 'all' && idea.status !== currentFilters.status) {
+                    return false;
+                }
+
+                if (currentFilters.tag !== 'all' && !idea.tags.includes(currentFilters.tag)) {
+                    return false;
+                }
+
+                return true;
+            });
+        }
+
+        function getStatusLabel(status) {
+            return status === 'new' ? 'new / to start' : status;
+        }
+
+        function closePanel() {
+            if (!panelOpen) return;
+            panelOpen = false;
+            selectedIdeaId = null;
+            panelEl.classList.remove('is-open');
+            backdropEl.classList.remove('is-open');
+            document.body.classList.remove('panel-open');
+            panelEl.hidden = true;
+            backdropEl.hidden = true;
+            document.querySelectorAll('.idea-card.is-selected').forEach(c => c.classList.remove('is-selected'));
+            if (previousFocus && typeof previousFocus.focus === 'function') {
+                previousFocus.focus();
+            }
+            previousFocus = null;
+        }
+
+        function getPanelFocusables() {
+            return Array.from(panelEl.querySelectorAll(FOCUSABLE)).filter(
+                el => !el.disabled && el.offsetParent !== null
+            );
+        }
+
+        function trapPanelFocus(e) {
+            if (!panelOpen || e.key !== 'Tab') return;
+            const focusables = getPanelFocusables();
+            if (focusables.length === 0) return;
+            const first = focusables[0];
+            const last = focusables[focusables.length - 1];
+            if (e.shiftKey && document.activeElement === first) {
+                e.preventDefault();
+                last.focus();
+            } else if (!e.shiftKey && document.activeElement === last) {
+                e.preventDefault();
+                first.focus();
+            }
+        }
+
+        function populatePanel(idea) {
+            panelTitleEl.textContent = idea.title;
+            panelBodyEl.innerHTML = `
+                <p class="panel-summary">${escapeHtml(idea.summary)}</p>
+                <div class="idea-meta">
+                    <div class="meta-row">
+                        <span class="meta-label">Status</span>
+                        <span class="status-badge status-${idea.status}">${escapeHtml(getStatusLabel(idea.status))}</span>
+                    </div>
+                    <div class="meta-row">
+                        <span class="meta-label">Source</span>
+                        <a href="${escapeHtml(idea.source)}" class="source-link" target="_blank" rel="noopener">${escapeHtml(idea.sourceLabel)}</a>
+                    </div>
+                    <div class="meta-row">
+                        <span class="meta-label">Saved</span>
+                        <span>${escapeHtml(idea.savedAt)}</span>
+                    </div>
+                </div>
+                <div class="tags">
+                    ${idea.tags.map(tag => `<span class="tag">${escapeHtml(tag)}</span>`).join('')}
+                </div>
+                <div class="prompt-section">
+                    <div class="prompt-header">
+                        <span class="prompt-label">AI Jumpstart Prompt</span>
+                        <button type="button" class="copy-btn" data-copy-prompt data-idea-id="${escapeHtml(idea.id)}">Copy prompt</button>
+                    </div>
+                    <div class="prompt-code" id="panelPromptCode">${escapeHtml(idea.jumpstartPrompt)}</div>
+                </div>
+            `;
+        }
+
+        function openPanel(ideaId) {
+            const idea = allIdeas.find(i => i.id === ideaId);
+            if (!idea) return;
+
+            previousFocus = document.activeElement;
+            selectedIdeaId = ideaId;
+            populatePanel(idea);
+
+            document.querySelectorAll('.idea-card.is-selected').forEach(c => c.classList.remove('is-selected'));
+            const card = document.querySelector(`.idea-card[data-idea-id="${CSS.escape(ideaId)}"]`);
+            if (card) card.classList.add('is-selected');
+
+            panelEl.hidden = false;
+            backdropEl.hidden = false;
+            requestAnimationFrame(() => {
+                panelEl.classList.add('is-open');
+                backdropEl.classList.add('is-open');
+                document.body.classList.add('panel-open');
+                panelOpen = true;
+                panelCloseEl.focus();
+            });
+        }
+
+        function renderIdeas() {
+            closePanel();
+
+            const filteredIdeas = filterIdeas();
+            const grid = document.getElementById('ideasGrid');
+            const resultsCount = document.getElementById('resultsCount');
+
+            resultsCount.textContent = `${filteredIdeas.length} ${filteredIdeas.length === 1 ? 'idea' : 'ideas'}`;
+
+            if (filteredIdeas.length === 0) {
+                grid.innerHTML = `
+                    <div class="empty-state">
+                        <h2>No ideas found</h2>
+                        <p>Try adjusting your search or filters.</p>
+                    </div>
+                `;
+                return;
+            }
+
+            grid.innerHTML = filteredIdeas.map(idea => `
+                <article class="idea-card" data-idea-id="${escapeHtml(idea.id)}">
+                    <div class="card-face">
+                        <div class="card-header">
+                            <h2 class="idea-title">${escapeHtml(idea.title)}</h2>
+                            <span class="status-badge status-${idea.status}">${escapeHtml(getStatusLabel(idea.status))}</span>
+                        </div>
+                        <p class="idea-summary">${escapeHtml(idea.summary)}</p>
+                        <button type="button" class="read-more-btn" data-open-idea="${escapeHtml(idea.id)}">Read more</button>
+                    </div>
+                </article>
+            `).join('');
+        }
+
+        async function copyPrompt(button, ideaId) {
+            const idea = allIdeas.find(i => i.id === ideaId);
+            if (!idea) return;
+
+            try {
+                await navigator.clipboard.writeText(idea.jumpstartPrompt);
+                const originalText = button.textContent;
+                button.textContent = 'Copied!';
+                button.classList.add('copied');
+
+                setTimeout(() => {
+                    button.textContent = originalText;
+                    button.classList.remove('copied');
+                }, 2000);
+            } catch (error) {
+                console.error('Failed to copy:', error);
+                alert('Failed to copy to clipboard. Please copy manually.');
+            }
+        }
+
+        function escapeHtml(text) {
+            const div = document.createElement('div');
+            div.textContent = text;
+            return div.innerHTML;
+        }
+
+        document.getElementById('searchInput').addEventListener('input', (e) => {
+            currentFilters.search = e.target.value;
+            document.getElementById('clearSearch').hidden = !e.target.value;
+            renderIdeas();
+        });
+
+        document.getElementById('clearSearch').addEventListener('click', () => {
+            const searchInput = document.getElementById('searchInput');
+            searchInput.value = '';
+            currentFilters.search = '';
+            document.getElementById('clearSearch').hidden = true;
+            renderIdeas();
+            searchInput.focus();
+        });
+
+        document.getElementById('statusFilters').addEventListener('click', (e) => {
+            if (e.target.classList.contains('filter-btn')) {
+                document.querySelectorAll('#statusFilters .filter-btn').forEach(btn => {
+                    btn.classList.remove('active');
+                    btn.setAttribute('aria-pressed', 'false');
+                });
+                e.target.classList.add('active');
+                e.target.setAttribute('aria-pressed', 'true');
+                currentFilters.status = e.target.dataset.status;
+                renderIdeas();
+            }
+        });
+
+        document.getElementById('tagFilters').addEventListener('click', (e) => {
+            if (e.target.classList.contains('filter-btn')) {
+                document.querySelectorAll('#tagFilters .filter-btn').forEach(btn => {
+                    btn.classList.remove('active');
+                    btn.setAttribute('aria-pressed', 'false');
+                });
+                e.target.classList.add('active');
+                e.target.setAttribute('aria-pressed', 'true');
+                currentFilters.tag = e.target.dataset.tag;
+                renderIdeas();
+            }
+        });
+
+        document.getElementById('ideasGrid').addEventListener('click', (e) => {
+            const btn = e.target.closest('[data-open-idea]');
+            if (!btn) return;
+            openPanel(btn.dataset.openIdea);
+        });
+
+        panelCloseEl.addEventListener('click', closePanel);
+        backdropEl.addEventListener('click', closePanel);
+
+        document.addEventListener('keydown', (e) => {
+            if (e.key === 'Escape' && panelOpen) {
+                e.preventDefault();
+                closePanel();
+            }
+            trapPanelFocus(e);
+        });
+
+        panelEl.addEventListener('click', (e) => {
+            const copyBtn = e.target.closest('[data-copy-prompt]');
+            if (copyBtn) {
+                copyPrompt(copyBtn, copyBtn.dataset.ideaId);
+            }
+        });
+
+        loadIdeas();
+    </script>
 </body>
 </html>
